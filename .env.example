# Local PostgreSQL; Docker Compose supplies its own hostname.
DATABASE_URL=postgresql+psycopg://moacut:moacut-local-only@127.0.0.1:54329/moacut
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
FACE_ANALYSIS_PROVIDER=fixture
DEMO_ENABLED=true
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
AWS_REGION=ap-northeast-2
S3_BUCKET=
REKOGNITION_SIMILARITY_THRESHOLD=90
REKOGNITION_CANDIDATE_MARGIN=5
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=300
# Use standard AWS credential chain/EC2 role. Do not put keys in frontend.

FIXTURE_MANIFEST=./backend/fixtures/manifest.json
