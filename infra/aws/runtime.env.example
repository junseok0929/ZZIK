# Copy to /etc/zzik/runtime.env on App EC2 only; never commit the filled file.
DATABASE_URL=postgresql+psycopg://zzik:URL_ENCODED_PASSWORD@RDS_ENDPOINT:5432/zzik?sslmode=verify-full&sslrootcert=/etc/zzik/global-bundle.pem
AWS_REGION=us-east-1
STORAGE_BACKEND=s3
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_PREFIX=zzik/
FACE_ANALYSIS_PROVIDER=rekognition
REKOGNITION_COLLECTION_PREFIX=zzik-
DEMO_ENABLED=false
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://YOUR_DOMAIN
STORAGE_ROOT=/var/lib/zzik
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=300
AWS_TIMEOUT_SECONDS=20
GEOCODING_URL=
