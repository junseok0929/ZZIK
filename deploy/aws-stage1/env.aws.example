# EC2 의 ~/zzik/.env 로 복사해 값을 채운다. 이 파일은 커밋하지 않는다(.gitignore 의 .env).
WEB_PORT=80
POSTGRES_PASSWORD=바꿔서-쓰는-긴-비밀번호
STORAGE_BACKEND=s3
S3_BUCKET=zzik-photos-본인이름
S3_PREFIX=moacut/
AWS_REGION=ap-northeast-2
# 사진 분석은 S3 이벤트 Lambda + Claude API 가 맡는다.
FACE_ANALYSIS_PROVIDER=lambda
# Lambda 의 INTERNAL_API_TOKEN 과 같은 값. 만들기: openssl rand -hex 32
INTERNAL_API_TOKEN=
# 공개 서버이므로 샘플 계정(공개 비밀번호)은 끈다.
DEMO_ENABLED=false
# 도메인·HTTPS 가 없으므로 false. HTTPS 를 붙이면 true 로 바꾼다.
COOKIE_SECURE=false
# 브라우저 주소. EC2 공인 IP 가 바뀌면 함께 바꾼다.
ALLOWED_ORIGINS=http://EC2_공인_IP
WORKER_CONCURRENCY=1
