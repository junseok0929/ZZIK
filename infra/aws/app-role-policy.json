{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectPhotoBucket",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_BUCKET"
    },
    {
      "Sid": "ListPhotoPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_BUCKET",
      "Condition": {"StringLike": {"s3:prefix": ["zzik", "zzik/*"]}}
    },
    {
      "Sid": "PhotoObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR_PRIVATE_BUCKET/zzik/*"
    },
    {
      "Sid": "AnalyzePhotosInVirginia",
      "Effect": "Allow",
      "Action": ["rekognition:DetectFaces", "rekognition:CompareFaces", "rekognition:DetectLabels", "rekognition:CreateCollection"],
      "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-1"}}
    },
    {
      "Sid": "AlbumFaceCollections",
      "Effect": "Allow",
      "Action": ["rekognition:DescribeCollection", "rekognition:IndexFaces", "rekognition:SearchFaces", "rekognition:DeleteFaces", "rekognition:DeleteCollection"],
      "Resource": "arn:aws:rekognition:us-east-1:YOUR_ACCOUNT_ID:collection/zzik-*"
    }
  ]
}
