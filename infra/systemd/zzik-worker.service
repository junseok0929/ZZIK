[Unit]
# The durable analysis worker. It leases jobs from PostgreSQL, so more than one
# instance may run; each additional host needs its own unit and the same env file.
Description=ZZIK analysis worker
Documentation=https://github.com/seopseopi/ZZIK/blob/main/docs/AWS_DEPLOYMENT.md
After=network-online.target zzik-api.service
Wants=network-online.target

[Service]
Type=exec
User=zzik
Group=zzik
WorkingDirectory=/opt/zzik/backend
EnvironmentFile=/etc/zzik/runtime.env
ExecStart=/opt/zzik/.venv/bin/python -m app.worker
# SIGTERM lets the current job finish or release its lease instead of stranding it.
Restart=always
RestartSec=5
TimeoutStopSec=180
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zzik-worker

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/var/lib/zzik
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
